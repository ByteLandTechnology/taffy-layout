{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["./src/index.ts"],
  "out": "./docs/api",
  "plugin": ["typedoc-plugin-markdown"],
  "name": "Taffy Layout API Documentation",
  "readme": "none",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "hideGenerator": true,
  "disableSources": true,
  "githubPages": false,
  "outputFileStrategy": "members",
  "flattenOutputFiles": false,
  "entryFileName": "index",
  "mergeReadme": false,
  "useCodeBlocks": true,
  "expandObjects": true,
  "parametersFormat": "table",
  "propertiesFormat": "table",
  "enumMembersFormat": "table",
  "typeDeclarationFormat": "table",
  "indexFormat": "table",
  "tableColumnSettings": {
    "hideDefaults": true
  },
  "pageTitleTemplates": {
    "member": "{name}"
  },
  "hideBreadcrumbs": true,
  "hidePageHeader": true,
  "navigation": {
    "includeCategories": false,
    "includeGroups": false
  }
}
